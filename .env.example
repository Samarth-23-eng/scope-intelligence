# Required for Docker Compose. Use a unique value outside local development.
POSTGRES_PASSWORD=change-me

# Optional collection integrations. The API starts without them and skips only
# the source that depends on an unset key.
NEWSAPI_KEY=
OPENROUTER_API_KEY=
PROXYCURL_API_KEY=

# One model connection is shared by every AI agent. You can configure this in
# the Model Connections screen instead. These values are the safe environment
# fallback for first startup and automation.
# Providers: openai, openrouter, anthropic, google, ollama, lmstudio,
# openai_compatible
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=
LLM_AUTH_MODE=api_key
LLM_MODEL=your-model-id
LLM_REQUEST_TIMEOUT_SECONDS=60
# Optional. If blank, the app creates a private key in its llm_secrets volume.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_MASTER_KEY=
# Delay between LLM analysis agents. Set to 0 when your provider does not require throttling.
ANALYSIS_RATE_LIMIT_SECONDS=15
ANALYSIS_STRUCTURED_REPAIR_ATTEMPTS=1
ANALYSIS_REPAIR_OUTPUT_CHARS=12000
ANALYSIS_EVIDENCE_PACK_MAX_HITS=36
ANALYSIS_EVIDENCE_PACK_MAX_CHARS=50000
ANALYSIS_EVIDENCE_PACK_PER_QUERY=12
ANALYSIS_EVIDENCE_PACK_MAX_PER_DOCUMENT=3
ANALYSIS_EVIDENCE_PACK_MAX_PER_DOMAIN=8

# Phase 1 evidence retrieval. The embedding model is local and is shared by all
# agents through Qdrant; it is not a second generative LLM.
EVIDENCE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EVIDENCE_EMBEDDING_CACHE=.cache/fastembed
EVIDENCE_CHUNK_CHARS=1600
EVIDENCE_CHUNK_OVERLAP_CHARS=200
EVIDENCE_INDEX_BATCH_SIZE=8
EVIDENCE_RETRIEVAL_LIMIT=30

# Crawler V2 uses HTTP for speed and Playwright only for JavaScript fallbacks.
CRAWLER_MAX_PAGES=80
CRAWLER_MAX_DEPTH=3
CRAWLER_CONCURRENCY=5
CRAWLER_MAX_BROWSER_FALLBACKS=12
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_RETRY_ATTEMPTS=2
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_MIN_CONTENT_CHARS=250
# Full extracted documents are retained up to this explicit UTF-8 byte budget.
# Agents search the resulting chunks rather than receiving the entire document.
CRAWLER_MAX_DOCUMENT_BYTES=10000000
CRAWLER_MAX_PDF_PAGES=80
CRAWLER_MAX_SITEMAPS=8
CRAWLER_MAX_SITEMAP_URLS=500
CRAWLER_RESUME_CAMPAIGNS=true
CRAWLER_MAX_EXTERNAL_PROFILES=80
# Experimental per-company recovery remains off until enabled in the dashboard.
# This global switch can disable the capability for every company.
CRAWLER_ACCESS_RECOVERY_AVAILABLE=true
CRAWLER_ACCESS_RECOVERY_MAX_ATTEMPTS=6
CRAWLER_ACCESS_RECOVERY_IMPERSONATE=chrome

# Phase 5 continuous intelligence scheduler. Individual company monitors remain
# disabled until enabled in that company's Watch Center.
MONITORING_SCHEDULER_ENABLED=true
MONITORING_SCHEDULER_POLL_SECONDS=30

# Multi-source job intelligence. LinkedIn is experimental and intentionally
# disabled by default because its automated collection policy is restrictive.
ENABLE_JOB_SCRAPER=true
ENABLE_LINKEDIN_SCRAPER=false
JOB_SOURCES=indeed,google
JOB_RESULTS_WANTED=30
JOB_SEARCH_LOCATION=
JOB_HOURS_OLD=720

# Optional public-source collectors. YouTube metadata/comments use the official
# Data API when a key is supplied. Transcript capture is bounded and may be
# unavailable when a video has no captions or the platform blocks the request.
ENABLE_EXTERNAL_SOURCES=true
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS=12
# Keep at 0 until a YouTube Data API key is configured.
YOUTUBE_COMMENTS_PER_VIDEO=0
ENABLE_YOUTUBE_TRANSCRIPTS=true
YOUTUBE_TRANSCRIPT_LANGUAGES=en,hi
GITHUB_TOKEN=
GITHUB_MAX_REPOSITORIES=20
GITHUB_RELEASES_PER_REPOSITORY=3
ENABLE_SOCIAL_COLLECTION=true
SOCIAL_MAX_ITEMS_PER_RUN=50
SOCIAL_MAX_COMMENTS_PER_ITEM=200
SOCIAL_MAX_REPLY_DEPTH=1
SOCIAL_REQUEST_DELAY_SECONDS=0.25
SOCIAL_RUN_TIMEOUT_SECONDS=900
SOCIAL_YOUTUBE_RETENTION_DAYS=30

# Experimental Deep Research Lab. This remains disabled unless explicitly
# enabled in Settings > Collection. Start the isolated Tor service separately:
# docker compose --profile deep-research up -d tor
ENABLE_DEEP_RESEARCH=false
TOR_SOCKS_PROXY_URL=socks5h://tor:9050
DEEP_RESEARCH_MAX_RESULTS=30
DEEP_RESEARCH_MAX_PAGES=12
DEEP_RESEARCH_REQUEST_DELAY_SECONDS=1.0
DEEP_RESEARCH_TIMEOUT_SECONDS=600
DEEP_RESEARCH_MAX_CONTENT_BYTES=1000000

# Comma-separated browser origins allowed to call the API. Keep this aligned
# with DASHBOARD_PORT when using a non-default local port.
CORS_ORIGINS=http://localhost:3000

# The URL embedded in the dashboard bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local host port for the dashboard. Change this if port 3000 is unavailable.
DASHBOARD_PORT=3000
